// Todayskin Prisma schema
// PostgreSQL + Prisma — T2 기준 초기 스키마
// 기존 SQLite 모델(models.py)과 최신 API 계약(BACKEND_TASKS.md)을 반영.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ── N6 FK onDelete 정책 표 ─────────────────────────
// Model                         | Parent        | onDelete | 근거
// ------------------------------+---------------+----------+------------------------------
// RefreshSession.user           | User          | Cascade  | 세션은 사용자와 함께 폐기
// ConsentRecord.user            | User          | Cascade  | 동의 기록은 사용자 종속
// NotificationPreference.user   | User          | Cascade  | 설정은 사용자 종속
// AsyncJob.user                 | User          | Cascade  | job은 사용자 종속
// AuditLog.actor                | User          | SetNull  | 감사 이력은 행위자 삭제 후에도 보존
// Diagnosis.user                | User          | SetNull  | 익명화 후 법적 보존
// Diagnosis.weatherSnapshot     | WeatherSnap.  | SetNull  | 스냅샷 삭제 시 진단은 유지
// DiagnosisImage.diagnosis      | Diagnosis     | Cascade  | 이미지 메타는 진단 종속
// DiagnosisImage.user           | User          | Cascade  | 사용자 삭제 시 메타 정리(객체는 선삭제)
// SkinMetric.diagnosis          | Diagnosis     | Cascade  | 부위 측정은 진단 종속
// Recommendation.user           | User          | Cascade  | 개인 추천은 사용자 종속
// Recommendation.diagnosis      | Diagnosis     | SetNull  | 진단 삭제 후에도 추천 문구 보존 가능
// Recommendation.template       | Template      | Restrict | 전역 템플릿 삭제 방지(기본 Restrict)
// RecommendationProduct.*       | Rec/Product   | Cascade  | 중간 테이블
// SocialAccount.user            | User          | Cascade  | 소셜 연결은 사용자 종속
// ───────────────────────────────────────────────────

// ── 권한 ──────────────────────────────────────────
enum Role {
  USER
  ADMIN
}

// ── 회원 ──────────────────────────────────────────
model User {
  id          Int      @id @default(autoincrement())
  // N33: 소셜 로그인 계정은 전화번호 없이 생성되고 온보딩에서 연결한다.
  // 전화 가입/로그인은 여전히 이 값으로 unique 조회한다 (nullable unique — NULL 허용).
  phoneNumber String?  @unique @map("phone_number")
  name        String
  // N33: 소셜 계정은 생년월일 없이 생성, 온보딩(전화 연결) 시 입력받는다.
  birthDate   DateTime? @map("birth_date")
  // 선택 입력. 모델 학습 전에는 추천 로직에 임의로 사용하지 않는다.
  gender      Gender?
  // T3에서 access token은 User 테이블에 저장하지 않고 RefreshSession으로 분리한다.
  role        Role     @default(USER)
  createdAt   DateTime @default(now()) @map("created_at")
  // N6 Soft Delete: 탈퇴 시 즉시 PII 스크럽 + deletedAt 설정.
  // purgeAfter 경과 후 purge job이 User를 물리 삭제한다.
  deletedAt   DateTime? @map("deleted_at")
  purgeAfter  DateTime? @map("purge_after")

  refreshSessions        RefreshSession[]
  diagnoses              Diagnosis[]
  diagnosisImages        DiagnosisImage[]
  recommendations        Recommendation[]
  notificationPreference NotificationPreference?
  consentRecords         ConsentRecord[]
  asyncJobs              AsyncJob[]
  aiCallReservations     AiCallReservation[]
  socialAccounts         SocialAccount[]

  auditLogs              AuditLog[]

  @@index([deletedAt, purgeAfter])
  @@map("users")
}

// N2: OTP 인증 — 가입·새 디바이스 로그인에 OTP 필수.
// 운영 공개 전까지 적용. 만료·시도 횟수·재전송 제한을 이 모델로 관리한다.
// N22: OTP code는 평문이 아닌 SHA-256(salt + code) 해시로 저장한다 — DB 유출 시에도
// 코드 원문이 노출되지 않는다. salt는 코드마다 무작위로 생성해 함께 저장한다.
model OtpCode {
  id           Int       @id @default(autoincrement())
  phoneNumber  String    @map("phone_number")
  // 6자리 코드의 해시 (SHA-256(salt + code)). 운영: 무작위, 개발(mock): 고정값.
  codeHash     String    @map("code_hash")
  // 코드별 무작위 salt.
  salt         String
  // OTP 용도: signup / login
  purpose      String
  // 검증 완료 여부. 성공 시 true로 전환.
  verified     Boolean   @default(false)
  attempts     Int       @default(0)
  // 최대 시도 횟수 초과 시 폐기. 기본 5.
  maxAttempts  Int       @default(5)
  expiresAt    DateTime  @map("expires_at")
  // 재전송 제한용 최근 발송 시각. 동일 번호 재전송은 최소 60초 간격.
  sentAt       DateTime  @default(now()) @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber, purpose])
  // R33/R11: 만료 코드 정리 스윕.
  @@index([expiresAt])
  @@map("otp_codes")
}

// N22: OTP 발송 로그 — 번호별 일일 발송 한도 집계 전용.
// otp_codes와 달리 프루닝(maxPending)·검증 소비(consumeVerification)의
// 대상이 아니어서 발송 횟수가 줄어들지 않는다.
// (일일 한도를 otp_codes row 수로 세면 maxPending 프루닝 때문에
//  count가 계속 3에 머물러 한도가 우회된다)
model OtpSendLog {
  id          Int      @id @default(autoincrement())
  phoneNumber String   @map("phone_number")
  // OTP 용도: signup / login
  purpose     String
  // 발송 시각 (KST 일일 집계 기준)
  sentAt      DateTime @default(now()) @map("sent_at")

  @@index([phoneNumber, sentAt])
  // R11: 발송 로그 보존 스윕.
  @@index([sentAt])
  @@map("otp_send_logs")
}

// N2: 감사 로그 — ADMIN 운영 API 호출 등 보안 관련 행위를 기록한다.
// N1 로깅(JSON)과 별개로 DB에 영구 보존해 이력 추적·컴플라이언스에 사용한다.
// 응답 본문·secret은 저장하지 않고, 행위 종류·대상·결과·메타만 저장한다.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  // 행위 종류: user_role_changed, user_deleted, ...
  action     String
  // 대상 엔티티(예: User)와 대상 ID
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  // 행위 결과: success / failure
  result     String   @default("success")
  // 부가 메타데이터(IP, UA 등). JSON 문자열.
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// N2: JWT key rotation(kid) — 다중 서명 키 지원.
// 현재 단일 secret에서 kid 기반 rotation으로 확장.
// active: 현재 서명에 사용, 이전 키는 verifyOnly로 검증만 수행.
model JwtKeyRotation {
  id        Int      @id @default(autoincrement())
  kid       String   @unique @map("kid")
  secret    String
  purpose   String   // access / refresh
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([purpose, active])
  @@map("jwt_key_rotations")
}

enum Gender {
  male
  female
}

// Refresh Token 회전·폐기·해시 저장 (T3에서 본격 사용)
model RefreshSession {
  id        String    @id @default(uuid())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  // R21: 회전 계열(rotation family). 한 로그인에서 파생된 세션들이 같은 값을 공유한다.
  // 이미 폐기된 토큰이 다시 쓰이면(탈취 신호) 같은 계열 전체를 폐기한다 — OAuth 2.0
  // Security BCP의 refresh token reuse detection. 기존 행은 자기 id로 백필한다.
  familyId  String    @map("family_id")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // R21: 재사용 탐지 시 계열 전체 폐기.
  @@index([familyId])
  // R33/R11: 만료·폐기 세션 보존 스윕.
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

// N3: 동의 기록 — 목적별 최신 상태 1건 (userId + purpose unique).
// purpose registry: diagnosis_image_processing / diagnosis_image_storage /
// ai_recommendation_data_transfer. 철회 시 revokedAt을 채우고 agreed=false.
model ConsentRecord {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  // 동의 목적. registry의 ConsentPurpose 값만 사용한다.
  purpose   String
  agreed    Boolean   @default(false)
  // 동의한 registry version. 필수 동의는 현재 requiredVersion과 일치해야 한다.
  version   String    @default("1.0.0")
  // 동의 수집 채널: app | web | admin 등.
  source    String?
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([userId])
  @@index([purpose, agreed])
  @@map("consent_records")
}

// ── 진단 ──────────────────────────────────────────
enum DiagnosisStatus {
  PENDING
  COMPLETED
  FAILED
}

enum FacePart {
  forehead
  glabella
  eyeArea
  cheek
  lips
  jaw
}

// N6 Soft Delete / 법적 보존:
// - 탈퇴·삭제 시 deletedAt + purgeAfter 설정, 원본 이미지는 즉시 물리 삭제.
// - 진단 점수·부위 결과는 anonymizedAt 이후 익명 보존(userId SetNull 가능).
// - User 물리 삭제(purge) 시 Diagnosis.userId는 SetNull로 남아 법적 보존한다.
model Diagnosis {
  id                 String          @id
  // User 탈퇴 purge 후 익명 보존을 위해 nullable + SetNull.
  userId             Int?            @map("user_id")
  capturedAt         DateTime        @map("captured_at")
  overallScore       Float           @map("overall_score")
  // 원본 이미지는 diagnosis_image_storage 동의 시에만 S3 저장. 미동의면 null.
  thumbnailUri       String?         @map("thumbnail_uri")
  status             DiagnosisStatus @default(PENDING)
  modelVersion       String?         @map("model_version")
  weatherSnapshotId  String?         @map("weather_snapshot_id")
  // N8: MediaPipe 얼굴 랜드마크(정규화 좌표). 조회는 저장 동의 시에만 노출.
  // shape: { version: string, points: number[][] } — points는 [[x,y], ...].
  landmarks          Json?
  // 신규(검증 단계): YOLO 여드름 구역 리포트 텍스트. 바운딩 박스 없이 한글 문장만.
  acneReport         String?         @map("acne_report")
  // 신규(검증 단계): 5클래스(건선/아토피/주사/지루/정상) 질환 분류. shape: { label, confidence }.
  diseaseClassification Json?        @map("disease_classification")
  createdAt          DateTime        @default(now()) @map("created_at")
  deletedAt          DateTime?       @map("deleted_at")
  purgeAfter         DateTime?       @map("purge_after")
  anonymizedAt       DateTime?       @map("anonymized_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  skinMetrics     SkinMetric[]
  weatherSnapshot WeatherSnapshot? @relation(fields: [weatherSnapshotId], references: [id], onDelete: SetNull)
  recommendations Recommendation[]
  // N3: 동의 기반 S3 이미지 메타데이터 (원본 바이너리는 S3에만).
  image           DiagnosisImage?

  // 캘린더·시계열: userId + capturedAt 범위. 단독 capturedAt은 날짜 범위 보조.
  @@index([userId, capturedAt])
  @@index([capturedAt])
  @@index([deletedAt, purgeAfter])
  @@map("diagnoses")
}

// N3: 진단 이미지 S3 메타데이터.
// 바이너리는 S3(SSE)에만 두고 DB에는 위치·암호화·크기만 보관한다.
// 저장 동의 철회 시 S3 객체를 삭제하고 deletedAt을 채운다.
model DiagnosisImage {
  id             String    @id @default(uuid())
  diagnosisId    String    @unique @map("diagnosis_id")
  userId         Int       @map("user_id")
  s3Bucket       String    @map("s3_bucket")
  s3Key          String    @map("s3_key")
  contentType    String    @map("content_type")
  sizeBytes      Int       @map("size_bytes")
  checksumSha256 String?   @map("checksum_sha256")
  // SSE-S3 AES256 또는 aws:kms
  encryption     String    @default("AES256")
  storedAt       DateTime  @default(now()) @map("stored_at")
  deletedAt      DateTime? @map("deleted_at")

  // N10: 삭제 수명주기 2단계 상태 (이미지 저장소 reconciliation)
  // - pendingDeleteAt != null && deletedAt == null → S3 객체 삭제 대기(재시도 대상)
  // - deletedAt != null → 객체 물리 삭제 완료(DB 메타는 감사 보존)
  pendingDeleteAt DateTime? @map("pending_delete_at")
  deleteAttempts  Int       @default(0) @map("delete_attempts")
  lastDeleteError String?   @map("last_delete_error")

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  // N10: 재시도 worker 스캔용 — 삭제 대기(미완료) row 조회
  @@index([pendingDeleteAt, deletedAt])
  @@map("diagnosis_images")
}



// 부위별 측정값 — 프론트 6개 부위 유지
model SkinMetric {
  id         Int      @id @default(autoincrement())
  diagnosisId String   @map("diagnosis_id")
  part       FacePart
  label      String
  grade      String
  moisture   Float?
  elasticity Float?
  note       String?

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@unique([diagnosisId, part])
  @@index([diagnosisId])
  @@map("skin_metrics")
}

// ── 날씨 ──────────────────────────────────────────
// 정부 API 실패 시 목업값으로 채우지 않고 nullable로 둔다.
enum WeatherSource {
  LIVE
  CACHED
  UNAVAILABLE
}

/// 대기질 등급 — 에어코리아 4단계 (좋음·보통·나쁨·매우나쁨).
enum AirStatus {
  good
  moderate
  bad
  veryBad
}

/// 자외선지수 등급 — 기상청 5단계 (낮음·보통·높음·매우높음·위험).
/// 자외선은 "좋음/나쁨"이 아니라 "낮음/높음"이라 AirStatus와 분리한다 (N40).
enum UvLevel {
  low
  moderate
  high
  veryHigh
  danger
}

model WeatherSnapshot {
  id              String   @id @default(uuid())
  observedAt      DateTime @map("observed_at")
  collectedAt     DateTime @default(now()) @map("collected_at")
  regionName      String   @map("region_name")
  cityName        String?  @map("city_name")
  /// F56: 시/군/구 표시명 (예: "해운대구"). 없으면 null.
  districtName    String?  @map("district_name")
  latitude        Float?
  longitude       Float?
  kmaAreaNo       String?  @map("kma_area_no")
  airkoreaStation String?  @map("airkorea_station_name")

  uvIndex        Float?      @map("uv_index")
  uvStatus       UvLevel?    @map("uv_status")
  uvIndexPeak    Float?      @map("uv_index_peak")
  uvStatusPeak   UvLevel?    @map("uv_status_peak")
  uvIndexPeakHour Int?       @map("uv_index_peak_hour")
  ozonePpm       Float?      @map("ozone_ppm")
  ozoneStatus    AirStatus?  @map("ozone_status")
  pm25           Float?
  pm25Status     AirStatus?  @map("pm25_status")
  pm10           Float?
  pm10Status     AirStatus?  @map("pm10_status")
  caiValue       Float?      @map("cai_value")
  caiStatus      AirStatus?  @map("cai_status")
  no2Value       Float?      @map("no2_value")
  so2Value       Float?      @map("so2_value")
  coValue        Float?      @map("co_value")

  /// N53: 기상청 초단기실황(T1H/REH). 피부 건조와 가장 직접 연관된 지표.
  temperature Float?
  humidity    Float?

  /// N42: 값이 비어 있는 이유가 "수집 실패"인지 "측정값 없음"인지 구분한다.
  /// 둘 다 null이면 화면이 똑같이 `-`로 그려서, 사용자는 일시적 장애인지
  /// 원래 값이 없었는지 알 수 없다. 외부 API 단위로 나눠 둔다.
  uvCollectionFailed  Boolean @default(false) @map("uv_collection_failed")
  airCollectionFailed Boolean @default(false) @map("air_collection_failed")
  /// N53: 초단기실황(기온·습도) 수집 실패 여부.
  nowcastCollectionFailed Boolean @default(false) @map("nowcast_collection_failed")

  source WeatherSource @default(LIVE)

  diagnoses Diagnosis[]

  @@index([regionName, observedAt])
  // R33/R11: 수집 시각 기준 조회·보존 스윕(스케줄러가 시간당 지역 수만큼 append한다).
  @@index([collectedAt])
  @@map("weather_snapshots")
}

// ── 추천 ──────────────────────────────────────────
enum EvidenceGrade {
  A
  B
  C
}

// 전역 A등급 템플릿 — user/diagnosis 없는 고정 문구
model RecommendationTemplate {
  id               String        @id
  title            String
  grade            EvidenceGrade
  sourceLabel      String        @map("source_label")
  // N45: content/evidence-sources.ts 레지스트리의 id. 확인된 출처만 화면에 뜬다.
  // A등급은 최소 1개가 있어야 한다(evidence-sources.spec.ts가 강제).
  sourceIds        String[]      @default([]) @map("source_ids")
  explanation      String
  observationalNote String?       @map("observational_note")
  ingredientTags   String[]      @default([]) @map("ingredient_tags")
  timing           String?
  createdAt        DateTime      @default(now()) @map("created_at")

  recommendations Recommendation[]
  products         RecommendationProduct[]

  // R33: 커서 페이지네이션(createdAt, id) 정렬.
  @@index([createdAt, id])
  @@map("recommendation_templates")
}

// 사용자별 생성 추천 (B등급: 사진+날씨 매칭, C등급: 개인 패턴)
model Recommendation {
  id               String   @id
  userId           Int?     @map("user_id")
  diagnosisId      String?  @map("diagnosis_id")
  templateId       String?  @map("template_id")
  title            String
  grade            EvidenceGrade
  sourceLabel      String   @map("source_label")
  explanation      String
  observationalNote String? @map("observational_note")
  ingredientTags   String[] @default([]) @map("ingredient_tags")
  timing           String?
  createdAt        DateTime @default(now()) @map("created_at")

  user      User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosis Diagnosis?             @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  template  RecommendationTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  products  RecommendationProduct[]

  @@index([userId, diagnosisId, createdAt])
  @@map("recommendations")
}

enum ProductCategory {
  moisture
  elasticity
  brightening
  barrier
}

model Product {
  id                 String          @id
  name               String
  brand              String
  imageUri           String?         @map("image_uri")
  // N24: 실제 구매 가능한 URL (FE가 Linking.openURL로 여는 값).
  // 허구 시드가 아닌 실제 카탈로그 제품에 채운다. 카탈로그 제품은 사실상 필수.
  purchaseUrl        String?         @map("purchase_url")
  matchedGrade       EvidenceGrade   @map("matched_grade")
  matchedIngredients String[]        @default([]) @map("matched_ingredients")
  category           ProductCategory
  // 날씨 기반 제품의 근거/타이밍 (reason, timing)
  reason             String?
  timing             String?
  createdAt          DateTime        @default(now()) @map("created_at")

  recommendations RecommendationProduct[]

  // R33: 카테고리 필터 + 커서 페이지네이션(createdAt, id) 정렬.
  @@index([category])
  @@index([createdAt, id])
  @@map("products")
}

// 추천-제품 중간 테이블 (N20: 템플릿 A등급과 생성 추천 B/C를 모두 연결하는 다형성 링크)
// 정확히 하나의 타깃만 채운다 — CHECK 제약은 마이그레이션에서 관리(Prisma 스키마 표현 불가).
model RecommendationProduct {
  id               Int      @id @default(autoincrement())
  recommendationId String?  @map("recommendation_id")
  templateId       String?  @map("template_id")
  productId        String   @map("product_id")
  displayOrder     Int      @default(0) @map("display_order")
  createdAt        DateTime @default(now()) @map("created_at")

  recommendation Recommendation?       @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  template        RecommendationTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, productId])
  @@unique([templateId, productId])
  @@index([recommendationId])
  @@index([templateId])
  @@index([productId])
  @@map("recommendation_products")
}

// ── 소셜 로그인 (N33) ─────────────────────────────
// 소셜 계정 ↔ Todayskin 계정 연결. provider + providerUserId unique로
// 같은 소셜 계정이 여러 Todayskin 계정을 만들지 않는다.
model SocialAccount {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  // kakao | google | apple
  provider       String
  // 제공자별 사용자 식별자 (kakao: id, google/apple: id_token sub)
  providerUserId String   @map("provider_user_id")
  // 제공자가 알려준 이메일 (선택, 사용자 동의에 따라 없을 수 있음)
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

// ── 알림 설정 ──────────────────────────────────────
model NotificationPreference {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique @map("user_id")
  // 푸시 발송은 N4 비동기 job. 설정 저장은 T11.
  pushEnabled       Boolean  @default(false) @map("push_enabled")
  uvAlertEnabled    Boolean  @default(true) @map("uv_alert_enabled")
  dustAlertEnabled  Boolean  @default(true) @map("dust_alert_enabled")
  morningReminder   Boolean  @default(false) @map("morning_reminder")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ── 비동기 Job (N4 BullMQ) ─────────────────────────
// API는 즉시 jobId를 반환하고, 결과는 polling/SSE로 조회한다.
// status 계약: PENDING → COMPLETED | FAILED
enum AsyncJobType {
  RECOMMENDATION_GENERATE
  // N31/N29: 날씨 기반 제품 LIVE 생성 — rec-fast-path 에픽에서 추가.
  WEATHER_PRODUCTS_GENERATE
  PATTERN_ANALYZE
  NOTIFICATION_SEND
}

enum AsyncJobStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AiCallReservationStatus {
  PENDING
  COMPLETED
  FAILED
}

model AsyncJob {
  id          String         @id @default(uuid())
  userId      Int            @map("user_id")
  type        AsyncJobType
  status      AsyncJobStatus @default(PENDING)
  // 낮을수록 높은 우선순위 (BullMQ priority와 동일)
  priority    Int            @default(5)
  attempts    Int            @default(0)
  maxAttempts Int            @default(3) @map("max_attempts")
  queueName   String         @map("queue_name")
  // BullMQ job id (inline 모드에서는 null)
  bullJobId   String?        @map("bull_job_id")
  payload     Json?
  result      Json?
  error       String?
  // R10: 중복 enqueue 방지 키. payload JSON 경로 비교(`payload->'diagnosisId'`)는
  // 행 단위로 평가돼 인덱스를 타지 못했다. 값을 정규 컬럼으로 승격해 순수 B-tree
  // 조회로 만든다. 키가 없는 job 종류(패턴 분석·알림)는 null.
  // 형식: `{payloadKey}:{value}` — buildJobDedupeKey()가 유일한 생성 지점이다.
  dedupeKey   String?        @map("dedupe_key")
  // 최종 실패 후 DLQ로 이동했는지
  deadLetter  Boolean        @default(false) @map("dead_letter")
  createdAt   DateTime       @default(now()) @map("created_at")
  startedAt   DateTime?      @map("started_at")
  finishedAt  DateTime?      @map("finished_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
  // R10: fast path dedupe 조회 — 홈 화면 진입마다 타는 가장 뜨거운 경로.
  // 백로그 제안과 달리 status를 넣지 않았다. AsyncJobStatus는 세 값뿐이고 조회는
  // 그 셋을 모두 IN으로 받아 사실상 필터가 아니다 — 넣으면 쓰기 비용만 늘어난다.
  // R11 보존 스윕은 기존 @@index([status, createdAt])로 충분하다.
  @@index([userId, type, dedupeKey, createdAt])
  @@map("async_jobs")
}

/// N14: 외부 AI 호출(추론/Gemini)의 동시 중복 방지용 in-flight 예약.
/// unique(scopeKey)로 한 요청만 PENDING을 보유한다.
/// - PENDING: 외부 호출 진행 중 (expiresAt 경과 시 다른 요청이 takeover)
/// - COMPLETED: 추천 생성 완료 — 동일 결과 재반환용으로 보존
/// - FAILED: 실패 — 다음 요청이 takeover해 재시도
/// 진단(diagnosis:{userId})은 완료/실패 시 release(삭제)해 순수 in-flight 가드로 쓴다.
model AiCallReservation {
  id        String                  @id @default(uuid())
  userId    Int                     @map("user_id")
  scopeKey  String                  @map("scope_key")
  status    AiCallReservationStatus @default(PENDING)
  expiresAt DateTime                @map("expires_at")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scopeKey])
  @@index([status, expiresAt])
  // R11: 완료된 예약 보존 스윕(status + updatedAt).
  @@index([status, updatedAt])
  @@map("ai_call_reservations")
}
