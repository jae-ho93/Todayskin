# 실제 기상청/에어코리아 연동 시 발급받은 공공데이터포털(data.go.kr) 키를 입력합니다.
# 비워두거나 외부 API 호출이 실패하면 목업값으로 대체하지 않고 해당 지표를 측정 불가로 반환합니다.
KMA_API_KEY=
AIRKOREA_API_KEY=

# B등급(사진+날씨 매칭) 추천 생성용. Google AI Studio에서 발급.
# 비워두거나 호출이 실패하면 추천 생성 API는 503을 반환합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# NestJS 전환 단계에서 사용할 예정인 환경변수입니다.
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=14d
REDIS_URL=
ALLOWED_ORIGINS=
