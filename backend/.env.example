# 실제 기상청/에어코리아 연동 시 발급받은 공공데이터포털(data.go.kr) 키를 여기 채우고
# 이 파일을 backend/.env 로 복사해서 사용하세요. (비워두면 각 항목별로 자동 목업 폴백)
KMA_API_KEY=
# 기상청 행정구역코드 (10자리). 기본값은 서울 종로구. 다른 지역이면 바꿀 것.
KMA_AREA_NO=1111000000

AIRKOREA_API_KEY=
# 에어코리아 측정소명 (동 단위 한글명). 기본값은 종로구.
AIRKOREA_STATION_NAME=종로구

# B등급(사진+날씨 매칭) 추천 생성용. Google AI Studio에서 발급.
# 비워두면 /recommendations/generate 가 자동으로 정적 목업으로 폴백한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
