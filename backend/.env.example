# ── NestJS 런타임 ─────────────────────────────
NODE_ENV=development
PORT=3000
# CORS 허용 오리진 — 쉼표로 구분 (예: http://localhost:8081,https://app.todayskin.kr)
# 개발 중 Expo 웹은 http://localhost:8081, 시뮬레이터/실기기는 LAN IP를 사용합니다.
ALLOWED_ORIGINS=http://localhost:8081

# ── DB (T2에서 필수) ───────────────────────────
# PostgreSQL 연결 문자열. 환경별 DB 분리 권장:
#   개발: postgresql://todayskin:secret@localhost:5432/todayskin_dev
#   테스트: postgresql://todayskin:secret@localhost:5432/todayskin_test
#   운영: 별도 관리 (컨테이너 외부, 별급 비밀번호)
DATABASE_URL=

# ── Redis (T12에서 필수, T2는 optional) ──────
REDIS_URL=
# 날씨 캐시 TTL(초). 기본 300초(5분). 정부 API 분 단위 갱신 기준.
WEATHER_CACHE_TTL_SECONDS=300

# ── JWT (T3에서 필수) ──────────────────────────
# 최소 32자 이상의 강력한 무작위 문자열. 운영에서는 비밀관리 도구로 주입.
# 예: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=14d

# ── 외부 API 키 ─────────────────────────────────
# 기상청/에어코리아 연동 시 발급받은 공공데이터포털(data.go.kr) 키를 입력.
# 비워두거나 호출 실패 시 목업값으로 채우지 않고 해당 지표를 측정 불가로 반환.
KMA_API_KEY=
AIRKOREA_API_KEY=

# 위치 권한 거부 / 근접측정소 조회 실패 시 기본 지역 fallback.
# 비워두면 서울 종로구(기본 region)를 사용한다.
KMA_AREA_NO=
AIRKOREA_STATION_NAME=

# B등급(사진+날씨 매칭) 추천 생성용. Google AI Studio에서 발급.
# 비워두거나 호출 실패 시 추천 생성 API는 503을 반환.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 개발용 Gemini mock 응답. 운영에서는 반드시 false여야 함.
# true면 GEMINI_API_KEY 없이도 추천/제품 생성 API가 고정 mock 응답을 반환한다.
MOCK_GEMINI=false

# ── 진단 추론 (T9) ─────────────────────────────
# 개발/통합 테스트용 mock 추론. 운영에서는 반드시 false여야 함.
# true면 진단 제출 시 고정 mock 값을 반환한다(실제 Python AI 서버 호출 없음).
# false로 설정해도 Python AI 서버가 준비되지 않았으므로 현재는 mock으로 폴백하되
# 경고 로그를 남긴다. PythonInferenceProvider 추가 후 폴백을 제거해야 한다.
MOCK_INFERENCE=true
