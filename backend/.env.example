# ── NestJS 런타임 ─────────────────────────────
NODE_ENV=development
PORT=3000
# CORS 허용 오리진 — 쉼표로 구분 (예: http://localhost:8081,https://app.todayskin.kr)
# 개발 중 Expo 웹은 http://localhost:8081, 시뮬레이터/실기기는 LAN IP를 사용합니다.
ALLOWED_ORIGINS=http://localhost:8081

# ── DB (T2에서 필수) ───────────────────────────
# PostgreSQL 연결 문자열. 환경별 DB 분리 권장:
#   개발: postgresql://todayskin:secret@localhost:5432/todayskin_dev
#   테스트: postgresql://todayskin:secret@localhost:5432/todayskin_test
#   운영: 별도 관리 (컨테이너 외부, 별급 비밀번호)
DATABASE_URL=

# ── Redis (T12에서 필수, T2는 optional) ──────
REDIS_URL=
# 날씨 캐시 TTL(초). 기본 300초(5분). 정부 API 분 단위 갱신 기준.
WEATHER_CACHE_TTL_SECONDS=300
# N4: Job dispatcher. auto(기본)=REDIS_URL 있으면 BullMQ, 없으면 Inline.
# 테스트/로컬에서 Redis 없이 동작시키려면 inline.
JOB_DISPATCHER=auto

# ── JWT (T3에서 필수) ──────────────────────────
# 최소 32자 이상의 강력한 무작위 문자열. 운영에서는 비밀관리 도구로 주입.
# 예: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=14d

# ── OTP 인증 (N2) ─────────────────────────────
# 가입·새 디바이스 로그인에 OTP 필수 (운영 공개 전).
# 개발: allowlisted test phone / mock OTP, 운영: 실제 SMS + 시도/만료/재전송 제한.
# OTP 코드 유효 시간(초). 기본 180(3분).
OTP_TTL_SECONDS=180
# 최대 검증 시도 횟수. 기본 5.
OTP_MAX_ATTEMPTS=5
# 재전송 대기 시간(초). 기본 60.
OTP_RESEND_COOLDOWN_SECONDS=60
# 번호별 미검증 코드 최대 개수. 기본 3.
OTP_MAX_PENDING_PER_PHONE=3
# 개발용 고정 OTP(123456)를 허용할 테스트 전화번호 (쉼표 구분, 하이픈 제거).
# 운영에서는 비워두세요. 예: 01012345678,01099999999
OTP_ALLOWLIST_PHONES=

# ── SMS 게이트웨이 (운영용, N2/N9 — 알리고 연동) ──
# 운영(NODE_ENV=production)에서 아래 4개가 빠지면 readiness(/health/ready)가 실패한다.
# 개발/테스트는 MockOtpProvider가 동작하므로 비워도 된다.
# 알리고(Aligo): https://smartsms.aligo.in/admin/api/spec.html
SMS_API_KEY=
# 알리고 user_id
SMS_USER_ID=
# 발신 번호 (알리고에서 등록·승인된 번호)
SMS_SENDER=
# 기본 https://apis.aligo.in/send/
SMS_ENDPOINT=https://apis.aligo.in/send/
# Y면 testmode_yn=Y 전송 — 실제 과금/발송 없이 연동 테스트만 수행 (개발 전용 권장)
SMS_TESTMODE=
# 발송 요청 timeout(ms). 기본 10000.
SMS_TIMEOUT_MS=10000
# 네트워크 오류 재시도 횟수. 기본 1 (최대 2). HTTP/API 거부는 재시도하지 않음(중복 발송 방지).
SMS_MAX_RETRIES=1

# ── 외부 API 키 ─────────────────────────────────
# 기상청/에어코리아 연동 시 발급받은 공공데이터포털(data.go.kr) 키를 입력.
# 비워두거나 호출 실패 시 목업값으로 채우지 않고 해당 지표를 측정 불가로 반환.
KMA_API_KEY=
AIRKOREA_API_KEY=

# 위치 권한 거부 / 근접측정소 조회 실패 시 기본 지역 fallback.
# 비워두면 서울 종로구(기본 region)를 사용한다.
KMA_AREA_NO=
AIRKOREA_STATION_NAME=

# B등급(사진+날씨 매칭) 추천 생성용. Google AI Studio에서 발급.
# 비워두거나 호출 실패 시 추천 생성 API는 503을 반환.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 개발용 Gemini mock 응답. 운영에서는 반드시 false여야 함.
# true면 GEMINI_API_KEY 없이도 추천/제품 생성 API가 고정 mock 응답을 반환한다.
MOCK_GEMINI=false

# ── 진단 추론 (T9) ─────────────────────────────
# 개발/통합 테스트용 mock 추론. 운영에서는 반드시 false여야 함.
# true면 진단 제출 시 고정 mock 값을 반환한다(실제 추론 서버 호출 없음).
MOCK_INFERENCE=false
# N13: NestJS↔inference-service 내부망 전용 인증 shared secret.
# NestJS와 inference-service가 같은 값을 공유해야 한다 (운영은 Secrets Manager로 주입).
# 미설정 시 inference-service /infer는 fail-closed(503)로 거부한다.
INFERENCE_SHARED_SECRET=

# ── 보안 / Rate Limit (N0/N11) ────────────────
# 분당 허용 요청 수(IP 기준). 기본 60.
THROTTLE_LIMIT=60
# Rate Limit 윈도우(밀리초). 기본 60000(1분).
THROTTLE_TTL_MS=60000
# N11: 분산 rate limit 저장소. auto(기본)=REDIS_URL 설정 시 Redis, 아니면 memory.
# ECS 다중 task 배포 시 redis로 두면 인스턴스별로 제한이 나뉘지 않는다.
# Redis 장애 시 fail-open(요청 통과) — 서비스 가용성을 우선한다.
THROTTLE_STORAGE=auto

# ── 비동기 job 지표 (N11) ───────────────────────
# BullMQ queue/DLQ 지표 수집 간격(ms). 0이면 비활성. 기본 60000(1분).
JOB_METRICS_INTERVAL_MS=60000

# ── 구조화 로깅 / 관측성 (N1) ───────────────
# 로그 레벨 — trace/debug/info/warn/error/fatal. 운영: info, 개발: debug.
LOG_LEVEL=info
# Sentry DSN. 비워두면 Sentry 비활성화. 운영에서만 설정 권장.
SENTRY_DSN=
# Sentry 트레이스 샘플링 비율 (0.0~1.0). 기본 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# backend/inference-service(학습된 MobileNetV3 모델을 감싼 FastAPI 서버) 주소.
# MOCK_INFERENCE=false일 때 이 값이 설정되어 있으면 PythonInferenceProvider가 사용된다.
# 비워두면 실제 provider가 연결될 때까지 진단 API가 503을 반환한다.
# 실행: cd backend/inference-service && python3 -m uvicorn main:app --host 127.0.0.1 --port 8000
INFERENCE_SERVICE_URL=http://127.0.0.1:8000

# ── S3 이미지 저장 (N3) ───────────────────────
# 동의한 진단 이미지만 암호화 저장. 비워두면 개발/테스트만 인메모리 store.
# 운영에서는 필수이며, 누락 시 서버가 시작되지 않음. secret(키)은 IAM Role/환경으로 주입.
S3_BUCKET=
AWS_REGION=ap-northeast-2
# SSE-KMS 사용 시 KMS Key ID. 비우면 SSE-S3 AES256.
S3_KMS_KEY_ID=

# ── 이미지 저장소 reconciliation (N10) ────────
# 삭제 실패(미완료) row 재시도 + orphan 객체 dry-run 스캔 스케줄 간격(ms).
# 0이면 비활성. 기본 3600000(1시간). orphan 실제 삭제는 ADMIN API로만 수행.
IMAGE_RECONCILE_INTERVAL_MS=3600000
# 삭제 재시도 최대 횟수. 초과 시 permanent failure 감사 로그(모니터링/알림 대상). 기본 10.
IMAGE_DELETE_MAX_ATTEMPTS=10

# ── 컨테이너 / 배포 (N5) ───────────────────────
# 로컬 docker compose backend 프로필만 true. 운영 ECS 앱 task는 반드시 false.
# true면 컨테이너 시작 시 prisma migrate deploy 실행.
RUN_MIGRATIONS_ON_START=false


# ── Soft Delete / Purge (N6) ───────────────────
# 탈퇴 Soft Delete 보존 기간(일). 기본 30. 경과 후 purge job이 User 물리 삭제.
SOFT_DELETE_RETENTION_DAYS=30
# purge 스케줄 간격(ms). 0이면 비활성. 기본 3600000(1시간).
SOFT_DELETE_PURGE_INTERVAL_MS=3600000

# ── 백그라운드 날씨 수집 ────────────────────────
# 개인 패턴 분석(T10)의 "그날 최고 UV/오존/미세먼지" 집계가 사용자 앱 사용 빈도와
# 무관하게 정확해지도록, 등록된 전체 지역(REGIONS)을 주기적으로 미리 수집해둔다.
# ms. 0이면 비활성. 기본 3600000(1시간). 지역 수가 많으면 정부 API 일일 호출 한도를
# 고려해 값을 늘릴 것 (지역 간 호출은 3초 간격으로 순차 실행됨).
WEATHER_COLLECTION_INTERVAL_MS=3600000
# N21: 백그라운드 날씨 수집 스케줄러 활성화 여부. ECS에서 task가 여러 개면 정확히 1개만 true로 둔다.
WEATHER_COLLECTOR_ENABLED=true

# production unknown key 엄격 검사에 사용하는 앱 env 선언 목록(쉼표).
# 비우면 unknown key 검사는 생략하고 mock flag 검사만 수행.
APP_ENV_KEYS=
