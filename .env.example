[TEMPLATE]
# ── API 서버 주소 ────────────────────────────────
# 실기기(Expo Go)에서 로컬 백엔드에 접속하려면, 아래 값을 자신의 PC LAN IP로 바꿔서
# ".env" 파일로 복사해 사용하세요 (예: ipconfig / ifconfig 로 확인한 IPv4 주소).
# 시뮬레이터/웹에서만 테스트한다면 이 값을 그대로 둬도 됩니다 (localhost 사용).
#
# ⚠️ APK(시연용 네이티브 빌드)를 만들 때는 **빌드 시점에 이 값이 박힙니다.**
# 반드시 운영 백엔드 URL로 바꿔서 빌드하세요:
#   EXPO_PUBLIC_API_BASE_URL=http://todayskin-alb-121101407.ap-northeast-2.elb.amazonaws.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3000

# ── 소셜 로그인 (카카오·구글 — 모두 무료) ──────────
# 각 제공자 콘솔에서 앱을 만들고 아래 키를 채웁니다. 미설정 시 해당 버튼은
# "설정이 아직 연결되지 않았습니다" 안내만 보입니다.
#
# ① 카카오 (https://developers.kakao.com)
#    - 내 애플리케이션 → 앱 생성 → "앱 키" 페이지의 **REST API 키**
#    - 카카오 로그인 활성화 + Redirect URI에 `weatherskin://oauth` 등록
#    - 앱 ID(숫자)는 백엔드 KAKAO_APP_ID로 전달 (타 앱 토큰 차단)
EXPO_PUBLIC_KAKAO_REST_API_KEY=
#
# ② 구글 (https://console.cloud.google.com)
#    - OAuth 동의 화면 구성 → 사용자 인증 정보 → OAuth 클라이언트 ID 3종 생성
#    - 웹: 승인된 리다이렉트 URI에 `https://auth.expo.io/@<유저>/<슬러그>` (Expo Go)
#    - Android: 패키지명 `com.todayskin.app` + SHA-1 지문 등록
#      리다이렉트 `weatherskin:/oauth` 자동 처리됨
#    - iOS: 번들 ID `com.todayskin.app`
#    - 3개 ID 모두 백엔드 GOOGLE_CLIENT_ID(쉼표 구분)에 등록해야 로그인 성공
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
